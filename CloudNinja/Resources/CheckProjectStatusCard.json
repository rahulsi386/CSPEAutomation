{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.2",
  "body": [
    {
      "type": "TextBlock",
      "text": "Check Project Status",
      "size": "Medium",
      "weight": "Bolder"
    },
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "110px",
          "items": [
            {
              "type": "TextBlock",
              "text": "Project Id:"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "Input.Text",
              "placeholder": "specify project guid",
              "id": "txtprojectid"
            }
          ]
        }
      ],
      "spacing": "Medium"
    },
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "110px",
          "items": [
            {
              "type": "TextBlock",
              "text": "Owner's Email:"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "Input.Text",
              "placeholder": "specify project owner's email id",
              "id": "txtprjowneremail",
              "style": "Email"
            }
          ]
        }
      ]
    },
    {
      "type": "ColumnSet",
      "spacing": "Medium",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "ActionSet",
              "actions": [
                {
                  "type": "Action.Submit",
                  "title": "Search",
                  "id": "btnsearch",
                  "style": "default",
                  "data": {
                    "btnName": "Search"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "ActionSet",
              "actions": [
                {
                  "type": "Action.Submit",
                  "title": "Cancel",
                  "id": "btncancel",
                  "data": {
                    "btnName": "Cancel"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}